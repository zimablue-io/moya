{
	"name": "moya",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"description": "One local-first personal assistant. Memory, routines, and models stay on this machine.",
	"author": "Lefa Moffat",
	"repository": {
		"type": "git",
		"url": "https://github.com/zimablue-io/moya.git"
	},
	"homepage": "https://github.com/zimablue-io/moya",
	"bugs": {
		"url": "https://github.com/zimablue-io/moya/issues"
	},
	"sideEffects": false,
	"type": "module",
	"overrides": {
		"nf3": "0.3.17"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"build": "vite build && npm run db:migrate",
		"db:migrate": "node scripts/migrate.mjs",
		"build:dev": "vite build --mode development",
		"preview": "vite preview --host 0.0.0.0 --port 5173",
		"build:desktop": "vite build --mode desktop && node scripts/desktop-frontend.mjs",
		"desktop": "tauri dev",
		"package:mac": "CI=true tauri build",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test 'scripts/**/*.test.mjs'",
		"shipping": "node --experimental-strip-types scripts/shipping-contract.mjs",
		"bump": "node --experimental-strip-types scripts/bump-version.mjs",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@electric-sql/pglite": "^0.5.4",
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/ubuntu": "^5.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.0",
		"@tanstack/react-start": "^1.168.0",
		"@tanstack/react-table": "^8.21.0",
		"@tanstack/router-plugin": "^1.168.0",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"better-auth": "^1.6.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.0.0",
		"kysely": "^0.28.5",
		"lucide-react": "^0.510.0",
		"pg": "^8.16.3",
		"react": "^19.2.0",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.2.0",
		"recharts": "^2.13.0",
		"shadcn": "^4.18.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.3.4",
		"zod": "^4.4.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^22.16.5",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.2.0",
		"lightningcss": "^1.28.0",
		"nitro": "3.0.260610-beta",
		"playwright": "^1.62.0",
		"typescript": "^5.7.0",
		"vite": "^8.2.0"
	},
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=24"
	}
}
